      "idea": "build expense tracker api",
      "code_target": "expense_api",
      "files": {
        "main.py": "\nfrom fastapi import FastAPI\n\n\n\napp = FastAPI()\n\n\nexpenses=[]\n\n\n\n\n\n\n\n\n@app.get(\n    \"/expenses\"\n)\ndef get_items():\n\n    return expenses\n\n\n@app.post(\n    \"/expenses\"\n)\ndef create_item(\n    amount: str,\n    category: str\n):\n\n    expenses.append(\n\n        {\n            \"amount\": amount,\n            \"category\": category\n        }\n    )\n\n    return {\n\n        \"success\":\n        True,\n\n        \"expenses\":\n        expenses\n    }\n\n\n@app.put(\n    \"/expenses/{item_id}\"\n)\ndef update_item(\n\n    item_id:int,\n\n    amount: str,\n    category: str\n):\n\n    if item_id >= len(\n        expenses\n    ):\n\n        return {\n\n            \"success\":\n            False\n        }\n\n\n    expenses[item_id] = {\n\n        \"amount\": amount,\n            \"category\": category\n    }\n\n\n    return {\n\n        \"success\":\n        True,\n\n        \"expenses\":\n        expenses\n    }\n\n\n@app.delete(\n    \"/expenses/{item_id}\"\n)\ndef delete_item(\n    item_id:int\n):\n\n    if item_id >= len(\n        expenses\n    ):\n\n        return {\n\n            \"success\":\n            False\n        }\n\n\n    expenses.pop(\n        item_id\n    )\n\n\n    return {\n\n        \"success\":\n        True\n    }\n\n",
