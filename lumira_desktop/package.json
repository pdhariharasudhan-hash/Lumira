{
    "name":  "lumira_desktop",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "lint":  "oxlint",
                    "preview":  "vite preview",
                    "test":  "vitest run",
                    "electron":  "electron .",
                    "dist":  "npm run build \u0026\u0026 electron-builder --win portable"
                },
    "dependencies":  {
                         "axios":  "^1.18.1",
                         "react":  "^19.2.7",
                         "react-dom":  "^19.2.7",
                         "react-icons":  "^5.6.0",
                         "react-router-dom":  "^7.18.0",
                         "zustand":  "^5.0.14"
                     },
    "devDependencies":  {
                            "@tailwindcss/vite":  "^4.3.1",
                            "@testing-library/dom":  "^10.4.2",
                            "@testing-library/react":  "^16.3.3",
                            "@types/node":  "^24.13.2",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^6.0.2",
                            "electron":  "^42.5.1",
                            "electron-builder":  "^26.18.0",
                            "jsdom":  "^30.1.1",
                            "oxlint":  "^1.69.0",
                            "tailwindcss":  "^4.3.1",
                            "typescript":  "~6.0.2",
                            "vite":  "^8.1.0",
                            "vitest":  "^5.0.2"
                        },
    "main":  "electron-main.cjs",
    "build":  {
                  "appId":  "com.lumira.personalai",
                  "productName":  "Lumira",
                  "files":  [
                                "dist/**/*",
                                "electron-main.cjs",
                                "package.json"
                            ],
                  "directories":  {
                                      "output":  "release"
                                  },
                  "win":  {
                              "target":  [
                                             "dir"
                                         ]
                          }
              }
}
