modules = ["python-3.12", "web", "nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "HOST=127.0.0.1 PORT=8000 RELOAD=false python run.py & exec npm --prefix lumira_desktop run dev -- --host 127.0.0.1 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
