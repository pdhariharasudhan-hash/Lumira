                    request
                ),
                mode_state
            )

        if capability == "notes":

            request = payload.get(
                "request",
                payload.get(
                    "idea",
                    payload.get(
                        "command",
                        ""
                    )
                )
            )

            return self._with_mode(
                self.personal.notes(
                    request
                ),
                mode_state
            )

        if capability == "calendar":

            request = payload.get(
                "request",
                payload.get(
                    "idea",
                    payload.get(
                        "command",
                        ""
                    )
                )
            )

            return self._with_mode(
                self.personal.calendar(
                    request
                ),
                mode_state
            )


        # --------------------------
        # UNKNOWN
        # --------------------------

        return {

            "success":
            False,

            "message":
            f"Unknown capability: {capability}"
        }