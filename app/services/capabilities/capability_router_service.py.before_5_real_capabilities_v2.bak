                "request",
                payload.get(
                    "idea",
                    payload.get(
                        "command",
                        ""
                    )
                )
            )

            return self._with_mode(
                self.growth.optimize(
                    request
                ),
                mode_state
            )

        # --------------------------
        # BUILDER / PROJECT ENGINEERING
        # --------------------------

        if capability == "project_engineering":

            idea = payload.get(
                "idea",
                payload.get(
                    "request",
                    payload.get(
                        "command",
                        ""
                    )
                )
            )

            return self._with_mode(
                self.builder.build(
                    idea
                ),
                mode_state
            )

        if capability == "code_generation":

            idea = payload.get(
                "idea",
                payload.get(
                    "request",
                    ""
                )
            )

            builder_result = (
                self.builder.build(
                    idea
                )
            )

            if builder_result.get("status") != "accept":

                return self._with_mode(
                    {
                        "success": False,
                        "status": builder_result.get(
                            "status",
                            "reject"
                        ),
                        "builder": builder_result,
                    },
                    mode_state
                )

            execution_result = (
                self.executor.execute(
                    idea,
                    builder_result
                )
            )

            if execution_result.get("status") != "accept":

                return self._with_mode(
                    {
                        "success": False,
                        "status": execution_result.get(
                            "status",
                            "reject"
                        ),
                        "builder": builder_result,
                        "execution": execution_result,
                    },
                    mode_state
                )

            code_result = (
                self.code.generate(
                    idea,
                    execution_result
                )
            )

            return self._with_mode(
                {
                    "success": True,
                    "status": code_result.get(
                        "status",
                        "accept"
                    ),
                    "builder": builder_result,
                    "execution": execution_result,
                    "code": code_result,
                },
                mode_state
            )


