class CapabilityRouterService:

    def __init__(self):

        self.features = (
            FeatureActivationService()
        )

        self.images = (
            ImageGenerationService()
        )

        self.search = (
            UnifiedSearchService()
        )

        self.builder = (
            BuilderService()
        )

        self.executor = (
            ExecuteService()
        )

        self.code = (
            CodeService()
        )


        self.mode_capabilities = (
            ModeCapabilityService()
        )

        self.planner = (
            PlannerService()
        )


        self.research = (
            ResearchCapabilityService()
        )

        self.operations = (
            OperationsCapabilityService()
        )

        self.creator = (
            CreatorCapabilityService()
        )

        self.generator = (
            GeneratorCapabilityService()
        )

        self.assistant = (
            AssistantCapabilityService()
        )

        self.personal = (
            PersonalCapabilityService()
        )


        self.growth = (
            GrowthCapabilityService()
        )

    # ==========================
    # MAIN ROUTER
    # ==========================

    @staticmethod
    def _with_mode(
        result,
        mode_state=None,
    ):
        if not isinstance(result, dict):
            result = {
                "success": True,
                "result": result,
            }

        output = dict(result)

        if mode_state is not None:
            output["mode"] = mode_state.active_mode

        return output



    def execute(
        self,
        capability: str,
        payload: dict = None,
        mode_state: ModeState = None,
    ):

        payload = payload or {}

        if mode_state is not None:
            resolution = (
                self.mode_capabilities.resolve(
                    mode_state,
                    capability,
                )
            )

            if not resolution["allowed"]:
                return {
                    "success": False,
                    "message": (
                        "Capability restricted by active mode: "
                        + resolution["mode"]
                    ),
                    "mode": resolution["mode"],
                    "capability": resolution["capability"],
                    "restricted": True,
                    "priority": resolution["priority"],
                }

        capability = (
            capability
            .strip()
            .lower()
        )

        # --------------------------
        # FEATURE ACTIVATION
        # --------------------------

        # --------------------------
        # PLANNING
        # --------------------------

        if capability == "planning":

            goal = payload.get(
                "request",
                payload.get(
                    "idea",
                    payload.get(
                        "command",
                        ""
                    )
                )
            )

            result = self.planner.create_plan(
                goal
            )

            return self._with_mode(
                result,
                mode_state
            )


        if capability == "activate_feature":

            return self.features.activate(

                payload.get(
                    "feature"
                )
            )

        if capability == "deactivate_feature":

            return self.features.deactivate(

                payload.get(
                    "feature"
                )
            )

        if capability == "feature_status":

            return self.features.status(

                payload.get(
                    "feature"
                )
            )

        if capability == "list_features":

            return self.features.list_features()

        # --------------------------
        # GROWTH
        # --------------------------

        if capability == "growth_strategy":

            request = payload.get(
                "request",
                payload.get(
                    "idea",
                    payload.get(
                        "command",
                        ""
                    )
                )
            )

            return self._with_mode(
                self.growth.growth_strategy(
                    request
                ),
                mode_state
            )

        if capability == "market_analysis":

            request = payload.get(
                "request",
                payload.get(
                    "idea",
                    payload.get(
                        "command",
                        ""
                    )
                )
            )

            return self._with_mode(
                self.growth.market_analysis(
                    request
                ),
                mode_state
            )

        if capability == "product_improvement":

