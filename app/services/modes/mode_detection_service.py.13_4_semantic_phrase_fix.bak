from typing import Dict, List
import re

from app.services.modes.mode_registry_service import (
    ModeRegistryService,
)

from app.services.modes.models.mode_detection import (
    ModeCandidate,
    ModeDetectionResult,
)


class ModeDetectionService:
    """
    Deterministic Intent + Domain mode detector.

    Pipeline:

        input
          ?
        normalization
          ?
        intent evidence
          ?
        domain evidence
          ?
        phrase evidence
          ?
        primary / secondary ranking
          ?
        ambiguity

    The detector recommends a primary mode.
    Secondary candidates are preserved.

    It never activates a mode.

    Ownership:
    Handoff 13.4 - Intent + Domain Evidence
    """

    AMBIGUITY_MARGIN = 0.20
    MIN_INTENT_SCORE = 0.75

    INTENT_WEIGHT = 1.00
    DOMAIN_WEIGHT = 0.35

